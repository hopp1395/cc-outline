{
  "name": "claude-code-extensions",
  "version": "0.1.0",
  "description": "Claude Code extensions: rendered session preview and git diff view in a terminal pane",
  "type": "module",
  "bin": {
    "cce": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "cli-highlight": "^2.1.11",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
