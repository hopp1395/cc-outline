{
  "description": "Tell a running cce viewer which session is active in this project, and close it when the session ends",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cce hook", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "cce hook", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "cce hook", "timeout": 10 }] }
    ]
  }
}
